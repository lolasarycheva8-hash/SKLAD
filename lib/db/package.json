{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "check:client-names": "node ./scripts/check-client-name-conflicts.mjs",
    "test:client-name-preflight": "node --test ./scripts/client-name-conflicts.test.mjs",
    "push": "pnpm run check:client-names && drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "pnpm run check:client-names && drizzle-kit push --force --config ./drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
